@{
    ViewData["Title"] = "Array";
    var items = (string[])(ViewBag.Items ?? new string[0]);
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>Array Operations</h1>
        <p class="yt-page-desc">Learn how to manipulate fixed-length arrays (Store, Add, Remove, and Index) in ASP.NET Core MVC.</p>
    </div>
</div>

<div class="row g-4 align-items-start">
    @* ── Left Column: Live Card ── *@
    <div class="col-lg-5">
        <div class="yt-card" id="arrayCard">
            <div class="yt-card-header">
                <h5 class="yt-card-title">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000">
                        <polygon points="6,3 18,12 6,21" />
                    </svg>
                    Array Visualizer
                </h5>
            </div>

            @* The array display *@
            <div class="array-display">
                <div class="array-length">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                        <path d="M4 10h16v2H4zm0-4h16v2H4zm0 8h16v2H4zm0 4h16v2H4z"/>
                    </svg>
                    <span>Length: <strong>@items.Length</strong> elements</span>
                </div>
                @if (items.Length == 0)
                {
                    <div class="array-empty mt-2">(empty array)</div>
                }
                else
                {
                    <div class="array-cells">
                        @for (int i = 0; i < items.Length; i++)
                        {
                            <div class="array-cell">
                                <span class="cell-index">[@i]</span>
                                <span class="cell-value">@items[i]</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <form method="post" asp-action="Array" class="mt-4 text-start">
                @foreach (var item in items)
                {
                    <input type="hidden" name="items" value="@item" />
                }

                <div class="mb-3">
                    <label for="addValue" class="form-label">Add value:</label>
                    <div class="input-group">
                        <input type="text" id="addValue" name="addValue" class="form-control" placeholder="e.g. Mango" />
                        <button type="submit" name="command" value="add" class="btn btn-primary">
                            Add
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="removeIndex" class="form-label">Remove value at index:</label>
                    <div class="input-group">
                        <input type="number" id="removeIndex" name="removeIndex" class="form-control" placeholder="e.g. 1" min="0" />
                        <button type="submit" name="command" value="remove" class="btn btn-danger">
                            Remove
                        </button>
                    </div>
                </div>

                <div class="mb-0">
                    <label for="printIndex" class="form-label">Print value at index:</label>
                    <div class="input-group">
                        <input type="number" id="printIndex" name="printIndex" class="form-control" placeholder="e.g. 0" min="0" />
                        <button type="submit" name="command" value="print" class="btn btn-outline-secondary">
                           Inspect
                        </button>
                    </div>
                </div>
            </form>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-@ViewBag.Color mt-4 mb-0 text-start">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">
                        Array Operation Result
                    </div>
                    <div class="fw-bold text-white">@ViewBag.Message</div>
                </div>
            }
        </div>
    </div>

    @* ── Right Column: YouTube Description & Code Panel ── *@
    <div class="col-lg-7">
        <div class="yt-description-box">

            <h5 class="fw-bold mb-2 text-white">📖 How It Works</h5>
            <p>
                An <em>array</em> is a contiguous collection of elements identified by zero-based indexes.
                Because native C# arrays possess a fixed capacity, adding or removing items internally initializes
                a new array with the updated size.
            </p>
            <p>
                In a stateless HTTP environment, the current elements are sent across requests via hidden input fields,
                allowing the controller to reconstruct the state on each command.
            </p>

            <h5 class="fw-bold mt-4 mb-2 text-white">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">Array</span>(<span class="keyword">string</span>[] items, <span class="keyword">string</span> command,
                             <span class="keyword">string</span> addValue, <span class="keyword">int</span>? removeIndex, <span class="keyword">int</span>? printIndex)
{
    <span class="keyword">if</span> (command == <span class="string">"add"</span>)
    {
        items = items.<span class="method">Append</span>(addValue).<span class="method">ToArray</span>();
    }
    <span class="keyword">else if</span> (command == <span class="string">"remove"</span>)
    {
        items = items.<span class="method">Where</span>((_, i) =&gt; i != removeIndex).<span class="method">ToArray</span>();
    }
    <span class="keyword">else if</span> (command == <span class="string">"print"</span>)
    {
        <span class="type">ViewBag</span>.Message = items[printIndex.Value];
    }

    <span class="type">ViewBag</span>.Items = items;
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-3">
<code><span class="comment">&lt;!-- View (Array.cshtml) --&gt;</span>
<span class="comment">@@</span><span class="keyword">for</span> (<span class="keyword">int</span> i = 0; i &lt; items.Length; i++)
{
    &lt;<span class="keyword">div</span> <span class="type">class</span>=<span class="string">"array-cell"</span>&gt;
        &lt;<span class="keyword">span</span>&gt;[<span class="comment">@@</span>i]&lt;/<span class="keyword">span</span>&gt;
        &lt;<span class="keyword">span</span>&gt;<span class="comment">@@</span>items[i]&lt;/<span class="keyword">span</span>&gt;
    &lt;/<span class="keyword">div</span>&gt;
}</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('arrayCard');

            // Add / Remove / Print: post without reloading
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                const data = new FormData(form, e.submitter);

                try {
                    const response = await fetch(form.action, { method: 'POST', body: data });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('arrayCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);

                    if (e.submitter) {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = e.submitter.name;
                        hidden.value = e.submitter.value;
                        form.appendChild(hidden);
                    }
                    form.submit();
                }
            });

            // Prevent wheel and arrow accidental increments
            card.addEventListener('wheel', function (e) {
                if (e.target.matches('input[type="number"]')) e.target.blur();
            });
            card.addEventListener('keydown', function (e) {
                if (e.target.matches('input[type="number"]') && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
                    e.preventDefault();
                }
            });
        })();
    </script>
}
