@{
    ViewData["Title"] = "Basic Input Output Using ASP.NET";
}

@section Styles {
    <style>
        /* Fill remaining viewport on large screens, allow natural scroll on small */
        .index-page {
            min-height: calc(100vh - 160px); /* subtract navbar + footer approx height */
            display: flex;
            flex-direction: column;
        }

        .index-body {
            flex: 1;
            align-content: center; /* centre the tiles vertically; each tile stretches to its row's height */
        }

        .program-card {
            min-height: 220px; /* every tile is at least this tall, so all tiles match */
            text-decoration: none;
            color: inherit;
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .program-card .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .program-card:hover {
            color: inherit;
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
        }

        .program-icon {
            font-size: 2.5rem;
        }

        .program-card .card-text {
            font-size: .9rem;
        }
    </style>
}

<div class="index-page">
    <div class="text-center mb-3">
        <h1 class="display-6 fw-bold">Basic Input Output Using ASP.NET</h1>
        <p class="text-muted mb-0">Pick a mini program to learn how input and output work in an ASP.NET Core MVC application.</p>
    </div>

    <div class="index-body row g-4 justify-content-center">
        @* ── Program Cards ── *@
        <div class="col-sm-6 col-lg-3">
            <a asp-action="GetInput" class="card program-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="program-icon mb-2">📝</div>
                    <h5 class="card-title">Get Input From User</h5>
                    <p class="card-text text-muted mb-0">Collect text from a form and print it back on the page.</p>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-lg-3">
            <a asp-action="SumOfTwoNumbers" class="card program-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="program-icon mb-2">➕</div>
                    <h5 class="card-title">Sum of Two Numbers</h5>
                    <p class="card-text text-muted mb-0">Read two numbers and display their total.</p>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-lg-3">
            <a asp-action="BasicComputation" class="card program-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="program-icon mb-2">🧮</div>
                    <h5 class="card-title">Basic Computation</h5>
                    <p class="card-text text-muted mb-0">Add, subtract, multiply, divide and find the remainder.</p>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-lg-3">
            <a asp-action="PopulatingFields" class="card program-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="program-icon mb-2">🧾</div>
                    <h5 class="card-title">Populating Fields</h5>
                    <p class="card-text text-muted mb-0">Fill form fields with values sent from the controller.</p>
                </div>
            </a>
        </div>
    </div>
</div>
