@{
    ViewData["Title"] = "Sum of Two Numbers";
}

@section Styles {
    <style>
        /* Fill remaining viewport on large screens, allow natural scroll on small */
        .sum-page {
            min-height: calc(100vh - 160px); /* subtract navbar + footer approx height */
            display: flex;
            flex-direction: column;
        }

        .sum-body {
            flex: 1;
            display: flex;
            align-items: stretch;
        }

        /* Keep the card in view (top-left) while the discussion scrolls */
        @@media (min-width: 992px) {
            .sum-column .card {
                position: sticky;
                top: 1rem;
            }
        }

        /* Number fields: no spinner arrows (scrolling/arrow keys must not change the value) */
        input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .snippet-block {
            background: #1e1e1e;
            color: #d4d4d4;
            border-radius: .5rem;
            padding: .75rem 1rem;
            font-size: .8rem;
            overflow-x: auto;
            text-align: left;
        }

        .snippet-block code {
            color: #d4d4d4;
            white-space: pre;
        }

        .keyword  { color: #569cd6; }
        .type     { color: #4ec9b0; }
        .string   { color: #ce9178; }
        .comment  { color: #6a9955; }
        .method   { color: #dcdcaa; }

        .discussion-section {
            text-align: left;
            font-size: .9rem;
        }

        .discussion-section h5 {
            font-weight: 600;
        }
    </style>
}

<div class="sum-page">
    <div class="text-center mb-3">
        <h1 class="display-6 fw-bold">Sum of Two Numbers</h1>
        <p class="text-muted mb-0">Learn how to read two numbers from a form and add them in an ASP.NET Core MVC application.</p>
    </div>

    <div class="sum-body row g-4">
        @* ── Left Column: Live Demo ── *@
        <div class="col-lg-5 d-flex flex-column justify-content-start sum-column">
            <div class="card shadow-sm" id="sumCard">
                <div class="card-body text-center">
                    <h5 class="card-title">🚀 Try It Out</h5>
                    <form method="post" asp-action="SumOfTwoNumbers" class="mt-3">
                        <div class="form-group mb-3">
                            <label for="num1" class="form-label">First number:</label>
                            <input type="number" step="any" id="num1" name="num1" class="form-control" placeholder="e.g. 12" value="@ViewBag.Num1" required />
                        </div>
                        <div class="form-group mb-3">
                            <label for="num2" class="form-label">Second number:</label>
                            <input type="number" step="any" id="num2" name="num2" class="form-control" placeholder="e.g. 30" value="@ViewBag.Num2" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Add</button>
                    </form>

                    @if (ViewBag.Sum != null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <strong>Result:</strong> @ViewBag.Num1 + @ViewBag.Num2 = <strong>@ViewBag.Sum</strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Right Column: Discussion & Snippet ── *@
        <div class="col-lg-7 discussion-section">
            <h5>📖 How It Works</h5>
            <p>
                Each <code>&lt;input&gt;</code> in the form has a <code>name</code> attribute.
                When the form is posted, ASP.NET Core MVC matches those names to the controller
                action's parameters (<em>model binding</em>) and converts the text to a number
                automatically. The action adds the two values and sends the result back to the
                view using <code>ViewBag</code>.
            </p>
            <p class="mb-0">
                The parameters are <code>double</code> so decimal values such as <code>2.5</code> work too.
            </p>

            <h5 class="mt-3">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">SumOfTwoNumbers</span>(<span class="keyword">double</span> num1, <span class="keyword">double</span> num2)
{
    <span class="type">ViewBag</span>.Num1 = num1;
    <span class="type">ViewBag</span>.Num2 = num2;
    <span class="type">ViewBag</span>.Sum  = num1 + num2;
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-2">
<code><span class="comment">&lt;!-- View (SumOfTwoNumbers.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"SumOfTwoNumbers"</span>&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"number"</span> <span class="type">name</span>=<span class="string">"num1"</span> /&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"number"</span> <span class="type">name</span>=<span class="string">"num2"</span> /&gt;
    &lt;<span class="keyword">button</span> <span class="type">type</span>=<span class="string">"submit"</span>&gt;Add&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;

<span class="comment">@@</span><span class="keyword">if</span> (ViewBag.Sum != <span class="keyword">null</span>)
{
    &lt;<span class="keyword">p</span>&gt;<span class="comment">@@</span>ViewBag.Num1 + <span class="comment">@@</span>ViewBag.Num2 = <span class="comment">@@</span>ViewBag.Sum&lt;/<span class="keyword">p</span>&gt;
}</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('sumCard');

            // Add: post the form in the background and swap in only the refreshed card
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                try {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('sumCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);
                    form.submit();   // fall back to a normal page post
                }
            });

            // Number fields must not change value with the mouse wheel or the arrow keys
            card.addEventListener('wheel', function (e) {
                if (e.target.matches('input[type="number"]')) e.target.blur();
            });
            card.addEventListener('keydown', function (e) {
                if (e.target.matches('input[type="number"]') && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
                    e.preventDefault();
                }
            });
        })();
    </script>
}
