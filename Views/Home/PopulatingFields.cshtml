@{
    ViewData["Title"] = "Populating Fields";
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>Populating Fields</h1>
        <p class="yt-page-desc">Learn how to populate and bind form inputs with data provided by an ASP.NET Core MVC controller.</p>
    </div>
</div>

<div class="row g-4 align-items-start">
    @* ── Left Column: Live Card ── *@
    <div class="col-lg-5">
        <div class="yt-card" id="profileCard">
            <div class="yt-card-header">
                <h5 class="yt-card-title">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000">
                        <polygon points="6,3 18,12 6,21" />
                    </svg>
                    Profile Editor
                </h5>
            </div>

            <form method="post" asp-action="PopulatingFields" class="text-start">
                <div class="mb-3">
                    <label for="name" class="form-label">Full Name:</label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Maria Santos" value="@ViewBag.Name" required />
                </div>
                <div class="mb-3">
                    <label for="age" class="form-label">Age:</label>
                    <input type="number" id="age" name="age" class="form-control" placeholder="e.g. 20" value="@ViewBag.Age" min="0" required />
                </div>
                <div class="mb-3">
                    <label for="city" class="form-label">City:</label>
                    <input type="text" id="city" name="city" class="form-control" placeholder="e.g. Quezon City" value="@ViewBag.City" required />
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <span class="me-1">▶</span> Save Profile
                    </button>
                    <a asp-action="PopulatingFields" asp-route-sample="true" data-swap class="btn btn-outline-secondary">
                        ⚡ Fill Sample Data
                    </a>
                </div>
            </form>

            @if (ViewBag.Submitted != null)
            {
                <div class="alert alert-success mt-4 mb-0 text-start">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--yt-green); font-weight: 600; margin-bottom: 6px;">
                        Profile Saved to ViewBag
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-4 text-secondary">Name:</dt>
                        <dd class="col-8 mb-1 fw-bold text-white">@ViewBag.Name</dd>
                        <dt class="col-4 text-secondary">Age:</dt>
                        <dd class="col-8 mb-1 fw-bold text-white">@ViewBag.Age yrs old</dd>
                        <dt class="col-4 text-secondary">City:</dt>
                        <dd class="col-8 mb-0 fw-bold text-white">@ViewBag.City</dd>
                    </dl>
                </div>
            }
        </div>
    </div>

    @* ── Right Column: Description & Code Panel ── *@
    <div class="col-lg-7">
        <div class="yt-description-box">


            <h5 class="fw-bold mb-2 text-white">📖 How It Works</h5>
            <p>
                A form field is <em>populated</em> by assigning its HTML <code>value</code> attribute from
                controller data. When you click <strong>Fill Sample Data</strong>, the <code>GET</code> action
                injects sample values into <code>ViewBag</code>; the view automatically renders them into each field.
            </p>
            <p>
                Upon submission, the <code>POST</code> action captures the incoming parameters and keeps them
                persisted. The AJAX script swaps the card cleanly without causing a page jump or disruption.
            </p>

            <h5 class="fw-bold mt-4 mb-2 text-white">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpGet</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">PopulatingFields</span>(<span class="keyword">bool</span> sample = <span class="keyword">false</span>)
{
    <span class="keyword">if</span> (sample)
    {
        <span class="type">ViewBag</span>.Name = <span class="string">"Maria Santos"</span>;
        <span class="type">ViewBag</span>.Age  = 20;
        <span class="type">ViewBag</span>.City = <span class="string">"Quezon City"</span>;
    }
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-3">
<code><span class="comment">&lt;!-- View (PopulatingFields.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"PopulatingFields"</span>&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"text"</span>   <span class="type">name</span>=<span class="string">"name"</span> <span class="type">value</span>=<span class="string">"@@ViewBag.Name"</span> /&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"number"</span> <span class="type">name</span>=<span class="string">"age"</span>  <span class="type">value</span>=<span class="string">"@@ViewBag.Age"</span> /&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"text"</span>   <span class="type">name</span>=<span class="string">"city"</span> <span class="type">value</span>=<span class="string">"@@ViewBag.City"</span> /&gt;
    &lt;<span class="keyword">button</span> <span class="type">type</span>=<span class="string">"submit"</span>&gt;Save Profile&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('profileCard');

            // Loads a page in the background and swaps in only the refreshed card
            async function load(url, options) {
                try {
                    const response = await fetch(url, options);
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('profileCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                    return true;
                } catch (e) {
                    console.error(e);
                    return false;
                }
            }

            // Save Profile: post the form without reloading the page
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();
                if (!(await load(form.action, { method: 'POST', body: new FormData(form) }))) {
                    form.submit();
                }
            });

            // Fill Sample Data: same with a GET request
            card.addEventListener('click', async function (e) {
                const link = e.target.closest('a[data-swap]');
                if (!link) return;
                e.preventDefault();
                if (!(await load(link.href))) {
                    window.location.href = link.href;
                }
            });

            // Number fields wheel and key guard
            card.addEventListener('wheel', function (e) {
                if (e.target.matches('input[type="number"]')) e.target.blur();
            });
            card.addEventListener('keydown', function (e) {
                if (e.target.matches('input[type="number"]') && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
                    e.preventDefault();
                }
            });
        })();
    </script>
}
