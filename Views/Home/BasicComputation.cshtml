@{
    ViewData["Title"] = "Basic Computation";
    var currentOp = ViewBag.Op as string ?? "+";
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>Basic Computation</h1>
        <p class="yt-page-desc">Learn how to select arithmetic operations and compute results in ASP.NET Core MVC.</p>
    </div>
</div>

<div class="row g-4 align-items-start">
    @* ── Left Column: Live Card ── *@
    <div class="col-lg-5">
        <div class="yt-card" id="calcCard">
            <div class="yt-card-header">
                <h5 class="yt-card-title">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000">
                        <polygon points="6,3 18,12 6,21" />
                    </svg>
                    Try It Out
                </h5>
            </div>

            <form method="post" asp-action="BasicComputation" id="calcForm">
                <div class="mb-3">
                    <label for="num1" class="form-label">First Number:</label>
                    <input type="number" step="any" id="num1" name="num1" class="form-control" placeholder="e.g. 24" value="@ViewBag.Num1" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Operator:</label>
                    <div class="yt-operator-pills">
                        <label class="yt-op-pill">
                            <input type="radio" name="op" value="+" @(currentOp == "+" ? "checked" : "") />
                            <span>+ (Add)</span>
                        </label>
                        <label class="yt-op-pill">
                            <input type="radio" name="op" value="-" @(currentOp == "-" ? "checked" : "") />
                            <span>− (Subtract)</span>
                        </label>
                        <label class="yt-op-pill">
                            <input type="radio" name="op" value="*" @(currentOp == "*" ? "checked" : "") />
                            <span>× (Multiply)</span>
                        </label>
                        <label class="yt-op-pill">
                            <input type="radio" name="op" value="/" @(currentOp == "/" ? "checked" : "") />
                            <span>÷ (Divide)</span>
                        </label>
                        <label class="yt-op-pill">
                            <input type="radio" name="op" value="%" @(currentOp == "%" ? "checked" : "") />
                            <span>% (Modulo)</span>
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="num2" class="form-label">Second Number:</label>
                    <input type="number" step="any" id="num2" name="num2" class="form-control" placeholder="e.g. 6" value="@ViewBag.Num2" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <span class="me-1">▶</span> Calculate
                </button>
            </form>

            @if (ViewBag.Answer != null)
            {
                <div class="alert alert-success mt-4 mb-0" id="calcResultAlert">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--yt-green); font-weight: 600; margin-bottom: 4px;">
                        Calculation Result
                    </div>
                    <strong>Equation:</strong> @ViewBag.Expression = <span class="badge bg-success fs-6 ms-1">@ViewBag.Answer</span>
                </div>
            }
            else if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-4 mb-0" id="calcErrorAlert">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--yt-red); font-weight: 600; margin-bottom: 4px;">
                        Calculation Error
                    </div>
                    <strong>Error:</strong> @ViewBag.Error
                </div>
            }
        </div>
    </div>

    @* ── Right Column: Description & Code Panel ── *@
    <div class="col-lg-7">
        <div class="yt-description-box">

            <h5 class="fw-bold mb-2 text-white">📖 How It Works</h5>
            <p>
                This form accepts a first operand (<code>num1</code>), an arithmetic operator (<code>op</code>),
                and a second operand (<code>num2</code>). When submitted, ASP.NET Core MVC maps the fields
                to the action parameters via model binding.
            </p>
            <p>
                The controller evaluates the operation using a C# pattern matching <code>switch</code> expression,
                handling special conditions like dividing by zero, and returns the computed result.
            </p>

            <h5 class="fw-bold mt-4 mb-2 text-white">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">BasicComputation</span>(<span class="keyword">double</span> num1, <span class="keyword">string</span> op, <span class="keyword">double</span> num2)
{
    <span class="keyword">double</span>? result = op <span class="keyword">switch</span>
    {
        <span class="string">"+"</span>                 =&gt; num1 + num2,
        <span class="string">"-"</span>                 =&gt; num1 - num2,
        <span class="string">"*"</span>                 =&gt; num1 * num2,
        <span class="string">"/"</span> <span class="keyword">when</span> num2 != 0 =&gt; num1 / num2,
        <span class="string">"%"</span> <span class="keyword">when</span> num2 != 0 =&gt; num1 % num2,
        _                   =&gt; <span class="keyword">null</span>
    };

    <span class="comment">// Returns result to ViewBag or JSON</span>
    <span class="type">ViewBag</span>.Answer = <span class="method">Format</span>(result.Value);
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-3">
<code><span class="comment">&lt;!-- View (BasicComputation.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"BasicComputation"</span>&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"number"</span> <span class="type">name</span>=<span class="string">"num1"</span> /&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"radio"</span>  <span class="type">name</span>=<span class="string">"op"</span> <span class="type">value</span>=<span class="string">"+"</span> /&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"number"</span> <span class="type">name</span>=<span class="string">"num2"</span> /&gt;
    &lt;<span class="keyword">button</span> <span class="type">type</span>=<span class="string">"submit"</span>&gt;Calculate&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('calcCard');

            // Calculate: post form without reloading the full page and swap in refreshed card
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                try {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('calcCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);
                    form.submit(); // fallback to regular post
                }
            });

            // Prevent scroll wheel and arrow keys from modifying number fields unintentionally
            card.addEventListener('wheel', function (e) {
                if (e.target.matches('input[type="number"]')) e.target.blur();
            });
            card.addEventListener('keydown', function (e) {
                if (e.target.matches('input[type="number"]') && (e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
                    e.preventDefault();
                }
            });
        })();
    </script>
}
