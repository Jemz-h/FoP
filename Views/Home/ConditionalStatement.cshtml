@{
    ViewData["Title"] = "Conditional Statement";
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>Conditional Statement</h1>
        <p class="yt-page-desc">Learn how if / else if / else branching statements dictate logic flow in an ASP.NET Core MVC application.</p>
    </div>
</div>

<div class="row g-4 align-items-start">
    @* ── Left Column: Live Card ── *@
    <div class="col-lg-5">
        <div class="yt-card" id="conditionalCard">
            <div class="yt-card-header">
                <h5 class="yt-card-title">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000">
                        <polygon points="6,3 18,12 6,21" />
                    </svg>
                    Branching Logic
                </h5>
            </div>

            <form method="post" asp-action="ConditionalStatement">
                <p class="form-label text-start">Select a Profile / Condition:</p>
                <div class="d-flex flex-column gap-2">
                    <button type="submit" name="name" value="Maria" class="btn btn-outline-secondary text-start d-flex justify-content-between align-items-center">
                        <span>👩‍💼 Maria</span>
                        <span class="badge" style="background-color: rgba(43, 166, 64, 0.2); color: var(--yt-green);">Status: Success</span>
                    </button>
                    <button type="submit" name="name" value="Juan" class="btn btn-outline-secondary text-start d-flex justify-content-between align-items-center">
                        <span>👨‍💻 Juan</span>
                        <span class="badge" style="background-color: rgba(62, 166, 255, 0.2); color: var(--yt-blue);">Status: Info</span>
                    </button>
                    <button type="submit" name="name" value="Ana" class="btn btn-outline-secondary text-start d-flex justify-content-between align-items-center">
                        <span>👩‍🔬 Ana</span>
                        <span class="badge" style="background-color: rgba(249, 171, 0, 0.2); color: var(--yt-yellow);">Status: Warning</span>
                    </button>
                </div>
            </form>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-@ViewBag.Color mt-4 mb-0 text-start">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 4px;">
                        Branch Executed: @ViewBag.Name
                    </div>
                    <div class="fw-bold text-white">@ViewBag.Message</div>
                </div>
            }
        </div>
    </div>

    @* ── Right Column: Description & Code Panel ── *@
    <div class="col-lg-7">
        <div class="yt-description-box">


            <h5 class="fw-bold mb-2 text-white">📖 How It Works</h5>
            <p>
                A <em>conditional statement</em> empowers code to dynamically decide paths during runtime.
                The controller inspects the button value submitted through the request and evaluates
                <code>if</code>, <code>else if</code>, and <code>else</code> branches sequentially.
            </p>
            <p>
                The matching block assigns an alert theme color and personalized response string to
                <code>ViewBag</code>.
            </p>

            <h5 class="fw-bold mt-4 mb-2 text-white">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">ConditionalStatement</span>(<span class="keyword">string</span> name)
{
    <span class="keyword">string</span> message;
    <span class="keyword">string</span> color;

    <span class="keyword">if</span> (name == <span class="string">"Maria"</span>)
    {
        message = <span class="string">"Welcome back, Maria! Everything is in order."</span>;
        color   = <span class="string">"success"</span>;
    }
    <span class="keyword">else if</span> (name == <span class="string">"Juan"</span>)
    {
        message = <span class="string">"Hello Juan! Here is some information for you."</span>;
        color   = <span class="string">"primary"</span>;
    }
    <span class="keyword">else if</span> (name == <span class="string">"Ana"</span>)
    {
        message = <span class="string">"Hi Ana! Please review your details."</span>;
        color   = <span class="string">"warning"</span>;
    }
    <span class="keyword">else</span>
    {
        message = <span class="string">"Unknown name. Please pick one of the buttons."</span>;
        color   = <span class="string">"secondary"</span>;
    }

    <span class="type">ViewBag</span>.Name    = name;
    <span class="type">ViewBag</span>.Message = message;
    <span class="type">ViewBag</span>.Color   = color;
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-3">
<code><span class="comment">&lt;!-- View (ConditionalStatement.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"ConditionalStatement"</span>&gt;
    &lt;<span class="keyword">button</span> <span class="type">submit</span> <span class="type">name</span>=<span class="string">"name"</span> <span class="type">value</span>=<span class="string">"Maria"</span>&gt;Maria&lt;/<span class="keyword">button</span>&gt;
    &lt;<span class="keyword">button</span> <span class="type">submit</span> <span class="type">name</span>=<span class="string">"name"</span> <span class="type">value</span>=<span class="string">"Juan"</span>&gt;Juan&lt;/<span class="keyword">button</span>&gt;
    &lt;<span class="keyword">button</span> <span class="type">submit</span> <span class="type">name</span>=<span class="string">"name"</span> <span class="type">value</span>=<span class="string">"Ana"</span>&gt;Ana&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('conditionalCard');

            // Click a name: post form in background and swap refreshed card
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                const data = new FormData(form, e.submitter);

                try {
                    const response = await fetch(form.action, { method: 'POST', body: data });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('conditionalCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);

                    if (e.submitter) {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = e.submitter.name;
                        hidden.value = e.submitter.value;
                        form.appendChild(hidden);
                    }
                    form.submit();
                }
            });
        })();
    </script>
}
