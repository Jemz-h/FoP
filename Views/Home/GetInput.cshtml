@{
    ViewData["Title"] = "Get Input From User";
}

@section Styles {
    <style>
        /* Fill remaining viewport on large screens, allow natural scroll on small */
        .getinput-page {
            min-height: calc(100vh - 160px); /* subtract navbar + footer approx height */
            display: flex;
            flex-direction: column;
        }

        .getinput-body {
            flex: 1;
            display: flex;
            align-items: stretch;
        }

        /* Keep the card in view (top-left) while the discussion scrolls */
        @@media (min-width: 992px) {
            .input-column .card {
                position: sticky;
                top: 1rem;
            }
        }

        .snippet-block {
            background: #1e1e1e;
            color: #d4d4d4;
            border-radius: .5rem;
            padding: .75rem 1rem;
            font-size: .8rem;
            overflow-x: auto;
            text-align: left;
        }

        .snippet-block code {
            color: #d4d4d4;
            white-space: pre;
        }

        .keyword  { color: #569cd6; }
        .type     { color: #4ec9b0; }
        .string   { color: #ce9178; }
        .comment  { color: #6a9955; }
        .method   { color: #dcdcaa; }

        .discussion-section {
            text-align: left;
            font-size: .9rem;
        }

        .discussion-section h5 {
            font-weight: 600;
        }
    </style>
}

<div class="getinput-page">
    <div class="text-center mb-3">
        <h1 class="display-6 fw-bold">Get Input From User</h1>
        <p class="text-muted mb-0">Learn how to accept user input in an ASP.NET Core MVC application.</p>
    </div>

    <div class="getinput-body row g-4">
        @* ── Left Column: Live Demo ── *@
        <div class="col-lg-5 d-flex flex-column justify-content-start input-column">
            <div class="card shadow-sm" id="inputCard">
                <div class="card-body text-center">
                    <h5 class="card-title">🚀 Try It Out</h5>
                    <form method="post" asp-action="GetInput" class="mt-3">
                        <div class="form-group mb-3">
                            <label for="userInput" class="form-label">Enter something:</label>
                            <input type="text" id="userInput" name="userInput" class="form-control" placeholder="Type here..." />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Print</button>
                    </form>

                    @if (ViewBag.UserInput != null)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <strong>You entered:</strong> @ViewBag.UserInput
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Right Column: Discussion & Snippet ── *@
        <div class="col-lg-7 discussion-section">
            <h5>📖 How It Works</h5>
            <p>
                In ASP.NET Core MVC, user input is collected through an HTML
                <code>&lt;form&gt;</code> that posts data back to a controller action.
                The controller receives the value via its parameter name, processes it,
                and passes it back to the view using <code>ViewBag</code>.
            </p>

            <h5 class="mt-3">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">GetInput</span>(<span class="keyword">string</span> userInput)
{
    <span class="type">ViewBag</span>.UserInput = userInput;
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-2">
<code><span class="comment">&lt;!-- View (GetInput.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"GetInput"</span>&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"text"</span> <span class="type">name</span>=<span class="string">"userInput"</span> /&gt;
    &lt;<span class="keyword">button</span> <span class="type">type</span>=<span class="string">"submit"</span>&gt;Print&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;

<span class="comment">@@</span><span class="keyword">if</span> (ViewBag.UserInput != <span class="keyword">null</span>)
{
    &lt;<span class="keyword">p</span>&gt;<span class="comment">@@</span>ViewBag.UserInput&lt;/<span class="keyword">p</span>&gt;
}</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('inputCard');

            // Print: post the form in the background and swap in only the refreshed card
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                try {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('inputCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);
                    form.submit();   // fall back to a normal page post
                }
            });
        })();
    </script>
}
