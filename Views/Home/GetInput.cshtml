@{
    ViewData["Title"] = "Get Input From User";
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>Get Input From User</h1>
        <p class="yt-page-desc">Learn how to capture user input through forms in an ASP.NET Core MVC application.</p>
    </div>
</div>

<div class="row g-4 align-items-start">
    @* ── Left Column: Live Stage ── *@
    <div class="col-lg-5">
        <div class="yt-card" id="inputCard">
            <div class="yt-card-header">
                <h5 class="yt-card-title">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#FF0000">
                        <polygon points="6,3 18,12 6,21" />
                    </svg>
                    Try It Out
                </h5>
            </div>

            <form method="post" asp-action="GetInput">
                <div class="mb-3">
                    <label for="userInput" class="form-label">Enter something:</label>
                    <input type="text" id="userInput" name="userInput" class="form-control" placeholder="Type a message or value..." required autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <span class="me-1">▶</span> Submit &amp; Print
                </button>
            </form>

            @if (ViewBag.UserInput != null)
            {
                <div class="alert alert-success mt-4 mb-0">
                    <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--yt-green); font-weight: 600; margin-bottom: 4px;">
                        Server Output Received
                    </div>
                    <strong>You entered:</strong> <span class="text-white">@ViewBag.UserInput</span>
                </div>
            }
        </div>
    </div>

    @* ── Right Column: Description & Code Panel ── *@
    <div class="col-lg-7">
        <div class="yt-description-box">


            <h5 class="fw-bold mb-2 text-white">📖 How It Works</h5>
            <p>
                In ASP.NET Core MVC, user input is collected through an HTML
                <code>&lt;form&gt;</code> that posts data back to a controller action.
                The controller receives the value via its matching parameter name (<em>Model Binding</em>),
                processes it, and passes it back to the view using <code>ViewBag</code>.
            </p>

            <h5 class="fw-bold mt-4 mb-2 text-white">🧩 Code Snippet</h5>
            <div class="snippet-block">
<code><span class="comment">// Controller (HomeController.cs)</span>
[<span class="type">HttpPost</span>]
<span class="keyword">public</span> <span class="type">IActionResult</span> <span class="method">GetInput</span>(<span class="keyword">string</span> userInput)
{
    <span class="type">ViewBag</span>.UserInput = userInput;
    <span class="keyword">return</span> <span class="method">View</span>();
}</code>
            </div>

            <div class="snippet-block mt-3">
<code><span class="comment">&lt;!-- View (GetInput.cshtml) --&gt;</span>
&lt;<span class="keyword">form</span> <span class="type">method</span>=<span class="string">"post"</span> <span class="type">asp-action</span>=<span class="string">"GetInput"</span>&gt;
    &lt;<span class="keyword">input</span> <span class="type">type</span>=<span class="string">"text"</span> <span class="type">name</span>=<span class="string">"userInput"</span> /&gt;
    &lt;<span class="keyword">button</span> <span class="type">type</span>=<span class="string">"submit"</span>&gt;Print&lt;/<span class="keyword">button</span>&gt;
&lt;/<span class="keyword">form</span>&gt;

<span class="comment">@@</span><span class="keyword">if</span> (ViewBag.UserInput != <span class="keyword">null</span>)
{
    &lt;<span class="keyword">p</span>&gt;<span class="comment">@@</span>ViewBag.UserInput&lt;/<span class="keyword">p</span>&gt;
}</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const card = document.getElementById('inputCard');

            // Print: post the form in the background and swap in only the refreshed card
            card.addEventListener('submit', async function (e) {
                const form = e.target;
                e.preventDefault();

                try {
                    const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                    if (!response.ok) throw new Error('HTTP ' + response.status);

                    const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const fresh = doc.getElementById('inputCard');
                    if (!fresh) throw new Error('Card not found in response');

                    card.innerHTML = fresh.innerHTML;
                } catch (err) {
                    console.error(err);
                    form.submit();   // fall back to a normal page post
                }
            });
        })();
    </script>
}
