@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="yt-page-header">
    <div class="yt-page-title-group">
        <h1>
            <span>Privacy Policy</span>
            <span class="badge" style="background-color: var(--yt-bg-chip); color: var(--yt-text-secondary); font-size: 0.8rem;">
                Official Policy
            </span>
        </h1>
        <p class="yt-page-desc">Information about how your learning progress and session data are handled in Prog_Fun.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="yt-description-box">
            <h5 class="fw-bold text-white mb-3">🛡️ Data Privacy &amp; Security</h5>
            <p>
                Prog_Fun is an educational project designed to showcase core programming fundamentals and ASP.NET Core MVC architecture.
            </p>
            <p>
                All form submissions, calculations, and data structures are processed securely within your active session and are not stored in any permanent external database or shared with third parties.
            </p>
            <hr class="yt-sidebar-divider" />
            <h6 class="fw-bold text-white mt-3">Cookies &amp; Local Storage</h6>
            <p class="text-secondary mb-0">
                We use strictly essential cookies and anti-forgery tokens (CSRF) required for secure HTTP POST transactions.
            </p>
        </div>
    </div>
</div>
