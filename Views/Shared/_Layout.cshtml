<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prog_Fun</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="yt-app">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "GetInput";
    }

    <div class="yt-main-layout">
        <div class="yt-content-wrapper">
            <!-- ── Top Filter Chips Navigation Bar ── -->
            <nav class="yt-chips-bar" aria-label="Exercise navigation">
                <a class="yt-chip @(currentAction == "GetInput" ? "active" : "")" asp-controller="Home" asp-action="GetInput">All</a>
                <a class="yt-chip @(currentAction == "GetInput" ? "active" : "")" asp-controller="Home" asp-action="GetInput">Get Input</a>
                <a class="yt-chip @(currentAction == "SumOfTwoNumbers" ? "active" : "")" asp-controller="Home" asp-action="SumOfTwoNumbers">Sum of Two</a>
                <a class="yt-chip @(currentAction == "BasicComputation" ? "active" : "")" asp-controller="Home" asp-action="BasicComputation">Calculator</a>
                <a class="yt-chip @(currentAction == "PopulatingFields" ? "active" : "")" asp-controller="Home" asp-action="PopulatingFields">Populate Fields</a>
                <a class="yt-chip @(currentAction == "ConditionalStatement" ? "active" : "")" asp-controller="Home" asp-action="ConditionalStatement">Conditionals</a>
                <a class="yt-chip @(currentAction == "Array" ? "active" : "")" asp-controller="Home" asp-action="Array">Arrays</a>
            </nav>

            <!-- ── Main Content Container ── -->
            <main role="main" class="yt-container">
                @RenderBody()
            </main>

            <footer class="yt-footer">
                <div>
                    <span>Prog_Fun &bull; Fundamentals of Programming</span>
                </div>
                <div>
                    <span>&copy; 2026 Prog_Fun</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
